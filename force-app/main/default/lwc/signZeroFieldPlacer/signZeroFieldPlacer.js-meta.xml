<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>SignZero Field Placer</masterLabel>
    <description>Flow screen component where the sender places each signer role's signatures on the PDF.</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="contentDocumentId" type="String" label="Content Document Id (PDF)" role="inputOnly"/>
            <property name="signers" type="apex://SignZeroSigner[]" label="Signers" role="inputOnly"/>
            <property name="fieldLayout" type="String" label="Field Layout"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
