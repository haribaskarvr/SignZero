    <description>Sends a PDF attached to the current record out for native e-signature with SignZero: choose the PDF (or upload one), name it, add the signers, send. Add it to any object as a Flow action and pass recordId.</description>
    <dynamicChoiceSets>
        <name>PdfChoices</name>
        <collectionReference>Get_PDFs</collectionReference>
        <dataType>String</dataType>
        <displayField>Title</displayField>
        <object>ContentVersion</object>
        <valueField>ContentDocumentId</valueField>
    </dynamicChoiceSets>
    <ends>
        <name>END_ELEMENT_3</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_4</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <description>The file to send: the passed-in ContentVersion&apos;s document, or the PDF chosen on screen.</description>
        <name>DocumentToSend</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!Get_Content_Version.ContentDocumentId}, {!chosenDocumentId})</expression>
    </formulas>
    <formulas>
        <description>SZ_Flow_Sent_Message with the envelope number, document title and signer count filled in.</description>
        <name>SentMessage</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!$Label.SZ_Flow_Sent_Message}, &quot;{0}&quot;, {!Get_Envelope.Name}), &quot;{1}&quot;, {!Get_Envelope.Document_Name__c}), &quot;{2}&quot;, TEXT({!Get_Envelope.Signers_Total__c}))</expression>
    </formulas>
    <formulas>
        <description>The title signers see: the one typed on screen, else the passed-in documentTitle. Blank uses the file name.</description>
        <name>TitleToSend</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!Document_Name}, {!documentTitle})</expression>
    </formulas>
